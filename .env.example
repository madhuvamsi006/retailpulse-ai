# Google Cloud
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-central1

# Vertex AI / Gemini
GEMINI_MODEL=gemini-2.0-flash-exp
EMBEDDING_MODEL=text-embedding-005

# BigQuery
BQ_DATASET=groundswell

# Firestore
FIRESTORE_DB=groundswell-db

# Model Armor
MODEL_ARMOR_TEMPLATE=gs-armor
MODEL_ARMOR_ENDPOINT=https://modelarmor.us-central1.rep.googleapis.com/v1

# Service URLs (set after Cloud Run deploy)
MCP_SERVICE_URL=http://localhost:8001
INVENTORY_A2A_URL=http://localhost:8002

# AP2 Keys (generate with: python -c "from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey; import base64; k=Ed25519PrivateKey.generate(); print(base64.b64encode(k.private_bytes_raw()).decode())")
AP2_MERCHANT_PRIVATE_KEY=
AP2_MERCHANT_PUBLIC_KEY=

# App
APP_ENV=development
SECRET_KEY=change-me-in-production
